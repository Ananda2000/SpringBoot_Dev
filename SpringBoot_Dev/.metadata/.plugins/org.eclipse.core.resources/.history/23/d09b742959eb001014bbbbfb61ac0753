// Delete call using @DeleteMapping.
	@DeleteMapping("/deleteRecord/{workname}")
	public String delete_todolist(@PathVariable("workname") String name)
	{
		String Deleted=name;
		int deleteData =todolist_service.Delete_todolist(name);
		if(deleteData >0)
		{
			Deleted =Deleted+" Deleted Successfully";
			
		}
		else
		{
			Deleted =Deleted+" Data is not available in Database";
		}
		return Deleted;
	}
	
