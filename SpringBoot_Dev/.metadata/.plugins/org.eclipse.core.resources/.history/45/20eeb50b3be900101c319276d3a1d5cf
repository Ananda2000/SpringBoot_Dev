{

	@Autowired
	JdbcTemplate jdbctemplateclass;
	
	
	String select_all = "select * from todo_list1";
	String insert_todolist = "insert into todo_list1 (workName, Status1) values(?,?)";
	String delete_todolist ="delete from todo_list1 where workName=?";
	String update_todolist ="update todo_list1 set status1=? where workname=?";
	String One_record = "select * from todo_list1 where workname=?";
